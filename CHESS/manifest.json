{
  "manifest_version": 3,
  "name": "ChessCoach REWORK — Liquid Glass & Tactical HUD",
  "version": "10.2.0",
  "description": "Интерактивный шахматный тренер и анализатор до 3000 ELO: HVH Cheat Revealer, честные правила, 11 стилей чемпионов и Liquid Glass HUD.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://lichess.org/*",
    "*://*.lichess.org/*",
    "*://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://lichess.org/*",
        "*://*.lichess.org/*"
      ],
      "js": [
        "content/main-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://lichess.org/*",
        "*://*.lichess.org/*"
      ],
      "js": [
        "lib/openings.js",
        "lib/explainer.js",
        "content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "options/*",
        "lib/*",
        "content/*"
      ],
      "matches": [
        "*://lichess.org/*",
        "*://*.lichess.org/*"
      ]
    }
  ]
}