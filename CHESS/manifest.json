{
  "manifest_version": 3,
  "name": "ChessCoach REWORK — Liquid Glass & 3D HUD",
  "version": "9.9.5",
  "description": "ChessCoach REWORK: 3D-стрелки, перспектива доски, MAIN-World WebSocket AutoMove и движок до 3000 ELO.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "*://lichess.org/*",
    "*://*.lichess.org/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://lichess.org/*",
        "*://*.lichess.org/*"
      ],
      "js": [
        "content/main-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://lichess.org/*",
        "*://*.lichess.org/*"
      ],
      "js": [
        "lib/openings.js",
        "lib/explainer.js",
        "content/content.js",
        "content/content2.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "options/*",
        "lib/*",
        "content/*"
      ],
      "matches": [
        "*://lichess.org/*",
        "*://*.lichess.org/*"
      ]
    }
  ]
}